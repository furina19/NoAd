<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础主题 - 浅色、干净 -->
    <style name="Theme.NoAd" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="android:statusBarColor">@color/bg_card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg_card</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- 工具栏标题样式 -->
    <style name="ToolbarTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>